# Save as: %APPDATA%\\Webnovel Translator\\.env
# Keep this file private. Never commit real API keys or service-role keys.

# Required primary translation model
GEMINI_API_KEY=

# AI #2 glossary extraction (optional: falls back to GEMINI_API_KEY_2 or primary key)
GEMINI_GLOSSARY_API_KEY=
GEMINI_API_KEY_2=

# AI #3 Myanmar polishing (optional: falls back to GEMINI_API_KEY_3)
GEMINI_POLISH_API_KEY=
GEMINI_API_KEY_3=

# Fallback API keys (optional)
GEMINI_BACKUP_API_KEY_1=
GEMINI_BACKUP_API_KEY_2=
GEMINI_BACKUP_API_KEY_3=
GEMINI_FALLBACK_API_KEY_1=
GEMINI_FALLBACK_API_KEY_2=
GEMINI_FALLBACK_API_KEY_3=

# Required database connection for this first desktop build.
# Local SQLite migration comes in a later, separately tested step.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
